#
# One copy of this file runs any number of bots, one per name: goodboy4@main, goodboy4@ari-server ...
# Each bot has its own settings (/etc/goodboy/<name>.env), its own secrets (/etc/goodboy/credentials/<name>/, readable
# by root only; systemd hands them to the bot and nobody else), and its own data (/var/lib/goodboy/<name>). Each one runs
# as its own throwaway user that can see nothing but its own data. install.sh sets all this up.
[Unit]
Description=Good Boy 4 (%i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/opt/goodboy/goodboy serve
EnvironmentFile=/etc/goodboy/%i.env
LoadCredential=bot-token:/etc/goodboy/credentials/%i/bot-token
LoadCredential=client-secret:/etc/goodboy/credentials/%i/client-secret
StateDirectory=goodboy/%i
StateDirectoryMode=0700
WorkingDirectory=/var/lib/goodboy/%i
Restart=always
RestartSec=5
TimeoutStopSec=20

# How much of the machine one bot may use. A hosting plan can change these with a drop-in
# (systemctl edit goodboy4@<name>): more memory and processor for Dedicated.
MemoryMax=768M
MemoryHigh=512M
CPUQuota=100%
TasksMax=256

# Keeps each bot away from the rest of the machine and from the other bots.
DynamicUser=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
