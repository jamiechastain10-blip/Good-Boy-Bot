# Basic Ghost Labs - Good Boy: a system service (installed by deploy/install-linux.sh)
[Unit]
Description=Good Boy Discord bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__NODE__ --disable-warning=ExperimentalWarning scripts/supervise.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
# Keeps the bot away from the rest of the machine.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__DIR__

[Install]
WantedBy=multi-user.target
