# Required
DISCORD_TOKEN=

# Optional - only needed for the web dashboard (http://localhost:3000)
DISCORD_CLIENT_SECRET=
DASHBOARD_PORT=3000
DASHBOARD_BASE_URL=http://localhost:3000

# Optional - only if you host the dashboard behind your own tunnel or proxy (see docs/HOSTING.md)
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_TRUST_PROXY=1

# Legal pages (/terms and /privacy on the dashboard address). Optional.
#LEGAL_OPERATOR=Your name or group
#LEGAL_CONTACT=you@example.com

# Updates (optional, OFF unless BOTH of these exist). See docs/UPDATES.md.
# The https address of the signed latest.json you publish, and update-public-key.pem placed next to this file.
#UPDATE_MANIFEST_URL=https://example.com/good-boy/latest.json
#UPDATE_CHANNEL=stable
#UPDATE_CHECK_HOURS=12

# Good Boy adds a "Good Boy vX · Basic Ghost Labs" line to the end of the bot's description in Discord
# (your own description text is kept). Every copy keeps this line, white-label ones included.

# Music (3.0): free Creative Commons music search through Jamendo. Get a free client ID at
# https://developer.jamendo.com and put it here. Without it, music still plays uploads and radio stations.
# JAMENDO_CLIENT_ID=

# The Good Boy hub (3.0): lets Good Boy bots find each other, so the server switcher shows servers run by other
# people's Good Boy bots. Put the hub's link here (see hub/README.md). Needs a public https dashboard link.
# GOODBOY_HUB_URL=https://goodboy-hub.example.workers.dev
# Set to off to leave the hub and stop showing up in other switchers.
# GOODBOY_HUB=off

