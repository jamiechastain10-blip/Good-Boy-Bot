{
  "name": "good-boy",
  "version": "3.0.1",
  "description": "Good Boy - modular Discord bot platform by Basic Ghost Labs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.js",
    "test": "node --disable-warning=ExperimentalWarning tests/run.js",
    "check": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/check.js",
    "invite": "node --env-file-if-exists=.env scripts/invite.js",
    "quote:test": "node scripts/quote-test.js",
    "supervised": "node --disable-warning=ExperimentalWarning scripts/supervise.js",
    "update": "node scripts/update.js",
    "release": "node scripts/release.js",
    "release:keygen": "node scripts/release-keygen.js"
  },
  "dependencies": {
    "discord.js": "^14.28.0",
    "semver": "^7.6.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "*",
    "@discordjs/voice": "*",
    "@snazzah/davey": "*",
    "opusscript": "*",
    "ffmpeg-static": "*",
    "google-tts-api": "*"
  }
}
