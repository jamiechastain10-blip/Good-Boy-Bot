{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Good Boy",
  "identifier": "labs.basicghost.goodboy4",
  "build": { "frontendDist": "../../launcher/ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Good Boy", "width": 1100, "height": 740, "minWidth": 380, "minHeight": 560, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
